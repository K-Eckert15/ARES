	(gr_text "Za is Patch impedance, Zp is desired impedance (50)"
		(at 153.307992 215.2375 0)
		(layer "User.2")
		(uuid "97c7db99-3000-4d37-b0be-3aeefd3873ab")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left bottom)
		)
	)
	(gr_text "L  = 1.10e3;\nZa = 289;   % edge impedance of the patch\nZp = 50;    % desired impedance at the inset point\n\nxp = (L/pi) * acos(sqrt(Zp/Za))\n\n\nSo xp = 399.7959"
		(at 88.307992 170.2375 0)
		(layer "User.2")
		(uuid "4c17c8e8-3a06-4cdd-b006-a64b5989ace1")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
