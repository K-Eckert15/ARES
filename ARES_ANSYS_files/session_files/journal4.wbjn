# encoding: utf-8
# 2026 R1
SetScriptVersion(Version="26.1.174")
template1 = GetTemplate(
    TemplateName="Static Structural",
    Solver="ANSYS")
system1 = GetSystem(Name="SYS 3")
system2 = template1.CreateSystem(
    Position="Right",
    RelativeTo=system1)
system2.DisplayText = "Canard"
geometry1 = system2.GetContainer(ComponentName="Geometry")
geometry1.SetFile(FilePath="C:/Users/lgord/Downloads/Canard.x_t")
modelComponent1 = system2.GetComponent(Name="Model")
modelComponent1.Refresh()
setupComponent1 = system2.GetComponent(Name="Setup")
setupComponent1.Refresh()
setup1 = system2.GetContainer(ComponentName="Setup")
setup1.Edit()
favorites1 = EngData.LoadFavoriteItems()
library1 = EngData.OpenLibrary(
    Name="Additive Manufacturing Materials",
    Source="Additive_Manufacturing_Materials.xml")
library2 = EngData.OpenLibrary(
    Name="ANSYS GRANTA Materials Data for Simulation (Sample)",
    Source="Granta_Design_Typical_Materials.xml")
system3 = GetSystem(Name="SYS")
system3.Copy(KeepConnections=True)
model1 = system2.GetContainer(ComponentName="Model")
model1.Exit()
system4 = GetSystem(Name="SYS 5")
system4.Move(
    Position="Right",
    RelativeTo=system2)
system2.Delete()
geometry2 = system4.GetContainer(ComponentName="Geometry")
geometry2.SetFile(FilePath="C:/Users/lgord/Downloads/Canard.x_t")
modelComponent2 = system4.GetComponent(Name="Model")
modelComponent2.Refresh()
setupComponent2 = system4.GetComponent(Name="Setup")
setupComponent2.Refresh()
setup2 = system4.GetContainer(ComponentName="Setup")
setup2.Edit()
Save(Overwrite=True)
model2 = system4.GetContainer(ComponentName="Model")
model2.Exit()
Save(Overwrite=True)
